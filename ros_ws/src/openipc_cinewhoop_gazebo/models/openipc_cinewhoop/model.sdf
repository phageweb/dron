<?xml version="1.0"?>
<sdf version="1.10">
  <model name="openipc_cinewhoop">
    <!-- World placement belongs to the including world, not the model. -->
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <!-- Publish rotor motion so motor mapping can be verified headlessly. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <link name="base_link">
      <inertial>
        <!-- Total assembled mass is 0.240 kg; fixed child-link masses below
             are explicit so SDF does not substitute its 1 kg default. -->
        <mass>0.200</mass>
        <inertia>
          <ixx>0.00022</ixx>
          <iyy>0.00022</iyy>
          <izz>0.00038</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.105 0.105 0.018</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.105 0.105 0.018</size></box></geometry>
        <material><diffuse>0.04 0.045 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="front_lidar_link">
      <pose relative_to="base_link">0.073 0 0.002 0 0 0</pose>
      <inertial><mass>0.004</mass><inertia><ixx>0.0000005</ixx><iyy>0.0000005</iyy><izz>0.0000005</izz></inertia></inertial>
      <visual name="visual">
        <geometry><box><size>0.018 0.030 0.014</size></box></geometry>
        <material><diffuse>0.85 0.85 0.78 1</diffuse></material>
      </visual>
      <sensor name="front_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/world/indoor_test/model/openipc_cinewhoop/link/front_lidar_link/sensor/front_lidar/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>61</samples>
              <resolution>1</resolution>
              <min_angle>-0.523599</min_angle>
              <max_angle>0.523599</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>
    <joint name="front_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_lidar_link</child>
    </joint>

    <link name="rangefinder_link">
      <pose relative_to="base_link">0.020 0 -0.016 0 1.57079632679 0</pose>
      <inertial><mass>0.002</mass><inertia><ixx>0.0000001</ixx><iyy>0.0000001</iyy><izz>0.0000001</izz></inertia></inertial>
      <sensor name="down_range" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/world/indoor_test/model/openipc_cinewhoop/link/rangefinder_link/sensor/down_range/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>
    <joint name="rangefinder_joint" type="fixed">
      <parent>base_link</parent>
      <child>rangefinder_link</child>
    </joint>

    <link name="imu_link">
      <pose relative_to="base_link">0 0 0.018 0 0 0</pose>
      <inertial><mass>0.002</mass><inertia><ixx>0.0000001</ixx><iyy>0.0000001</iyy><izz>0.0000001</izz></inertia></inertial>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/world/indoor_test/model/openipc_cinewhoop/link/imu_link/sensor/imu/imu</topic>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name="camera_link">
      <pose relative_to="base_link">0.068 0 0.012 0 0 0</pose>
      <inertial><mass>0.006</mass><inertia><ixx>0.0000005</ixx><iyy>0.0000005</iyy><izz>0.0000005</izz></inertia></inertial>
      <visual name="visual">
        <geometry><box><size>0.026 0.022 0.020</size></box></geometry>
        <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/world/indoor_test/model/openipc_cinewhoop/link/camera_link/sensor/front_camera/image</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="motor_1"><pose relative_to="base_link">0.04455 -0.04455 0.012 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>0.0000002</ixx><iyy>0.0000002</iyy><izz>0.0000002</izz></inertia></inertial></link>
    <joint name="motor_1_joint" type="fixed"><parent>base_link</parent><child>motor_1</child></joint>
    <link name="motor_2"><pose relative_to="base_link">-0.04455 0.04455 0.012 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>0.0000002</ixx><iyy>0.0000002</iyy><izz>0.0000002</izz></inertia></inertial></link>
    <joint name="motor_2_joint" type="fixed"><parent>base_link</parent><child>motor_2</child></joint>
    <link name="motor_3"><pose relative_to="base_link">0.04455 0.04455 0.012 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>0.0000002</ixx><iyy>0.0000002</iyy><izz>0.0000002</izz></inertia></inertial></link>
    <joint name="motor_3_joint" type="fixed"><parent>base_link</parent><child>motor_3</child></joint>
    <link name="motor_4"><pose relative_to="base_link">-0.04455 -0.04455 0.012 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>0.0000002</ixx><iyy>0.0000002</iyy><izz>0.0000002</izz></inertia></inertial></link>
    <joint name="motor_4_joint" type="fixed"><parent>base_link</parent><child>motor_4</child></joint>

    <!-- 3 inch propellers, ordered like ArduPilot's Quad X reference model. -->
    <link name="rotor_0"><pose relative_to="base_link">0.04455 -0.04455 0.025 0 0 0</pose><inertial><mass>0.0015</mass><inertia><ixx>0.0000004</ixx><iyy>0.0000004</iyy><izz>0.0000008</izz></inertia></inertial><visual name="prop"><geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry><material><diffuse>0.2 0.7 1 1</diffuse></material></visual></link>
    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00002</damping></dynamics></axis></joint>
    <link name="rotor_1"><pose relative_to="base_link">-0.04455 0.04455 0.025 0 0 0</pose><inertial><mass>0.0015</mass><inertia><ixx>0.0000004</ixx><iyy>0.0000004</iyy><izz>0.0000008</izz></inertia></inertial><visual name="prop"><geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry><material><diffuse>0.2 0.7 1 1</diffuse></material></visual></link>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00002</damping></dynamics></axis></joint>
    <link name="rotor_2"><pose relative_to="base_link">0.04455 0.04455 0.025 0 0 0</pose><inertial><mass>0.0015</mass><inertia><ixx>0.0000004</ixx><iyy>0.0000004</iyy><izz>0.0000008</izz></inertia></inertial><visual name="prop"><geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry><material><diffuse>1 0.45 0.2 1</diffuse></material></visual></link>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00002</damping></dynamics></axis></joint>
    <link name="rotor_3"><pose relative_to="base_link">-0.04455 -0.04455 0.025 0 0 0</pose><inertial><mass>0.0015</mass><inertia><ixx>0.0000004</ixx><iyy>0.0000004</iyy><izz>0.0000008</izz></inertia></inertial><visual name="prop"><geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry><material><diffuse>1 0.45 0.2 1</diffuse></material></visual></link>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00002</damping></dynamics></axis></joint>

    <!-- Two blade surfaces per propeller. The paired forward directions give
         a rotating propeller lift without adding collisions to the ducts. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.032 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.032 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.032 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.032 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.032 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.032 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.032 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cla_stall>-0.025</cla_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.032 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3</link_name></plugin>

    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_0_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_joint</joint_name></plugin>

    <!--
      The ArduPilot Gazebo plugin exchanges IMU and pose state as JSON with
      SITL and drives the four aerodynamic propeller joints below.
    -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>

      <!-- Convert Gazebo ENU / FLU into ArduPilot NED / FRD. -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <imuName>imu_link::imu</imuName>

      <!-- Quad X mapping follows the Iris reference model, scaled for 3 in props. -->
      <control channel="0"><jointName>rotor_0_joint</jointName><useForce>1</useForce><multiplier>1600</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.1</cmd_max><cmd_min>-0.1</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      <control channel="1"><jointName>rotor_1_joint</jointName><useForce>1</useForce><multiplier>1600</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.1</cmd_max><cmd_min>-0.1</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      <control channel="2"><jointName>rotor_2_joint</jointName><useForce>1</useForce><multiplier>-1600</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.1</cmd_max><cmd_min>-0.1</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      <control channel="3"><jointName>rotor_3_joint</jointName><useForce>1</useForce><multiplier>-1600</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.1</cmd_max><cmd_min>-0.1</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
    </plugin>
  </model>
</sdf>
