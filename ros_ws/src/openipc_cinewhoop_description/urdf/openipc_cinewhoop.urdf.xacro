<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openipc_cinewhoop">
  <!-- Half the 128 mm wheelbase GEPRC publish for the CineLog30 V3, divided by
       sqrt(2) for the quad X diagonal. The spec carried 126 mm, which was the
       original assumption rather than the frame's real figure. -->
  <xacro:property name="arm" value="0.04525"/>
  <xacro:property name="prop_r" value="0.0381"/>

  <material name="carbon"><color rgba="0.04 0.045 0.05 1.0"/></material>
  <material name="duct"><color rgba="0.02 0.30 0.45 1.0"/></material>
  <material name="sensor"><color rgba="0.85 0.85 0.78 1.0"/></material>
  <material name="camera"><color rgba="0.08 0.08 0.08 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.105 0.105 0.018"/></geometry>
      <material name="carbon"/>
    </visual>
    <collision>
      <geometry><box size="0.105 0.105 0.018"/></geometry>
    </collision>
    <inertial>
      <mass value="0.240"/>
      <inertia ixx="0.00022" ixy="0" ixz="0" iyy="0.00022" iyz="0" izz="0.00038"/>
    </inertial>
  </link>

  <xacro:macro name="fixed_box_link" params="name xyz size material rpy:='0 0 0'">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${size}"/></geometry>
        <material name="${material}"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="motor" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.011" length="0.018"/></geometry>
        <material name="sensor"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.012" rpy="0 0 0"/>
        <geometry><cylinder radius="${prop_r}" length="0.003"/></geometry>
        <material name="duct"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.012" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:fixed_box_link name="camera_link" xyz="0.068 0 0.012" size="0.026 0.022 0.020" material="camera"/>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.014 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <xacro:fixed_box_link name="imu_link" xyz="0 0 0.018" size="0.018 0.018 0.006" material="sensor"/>
  <!-- Both downward sensors measure along +X of their own frame, so the frames
       are pitched 90 degrees to point at the floor. The simulated sensor link
       carries the same rotation; a frame that disagrees with the beam would
       place the measurement in front of the drone instead of below it. -->
  <xacro:fixed_box_link name="optical_flow_link" xyz="0 0 -0.016" rpy="0 ${pi/2} 0" size="0.018 0.018 0.006" material="sensor"/>
  <xacro:fixed_box_link name="rangefinder_link" xyz="0.020 0 -0.016" rpy="0 ${pi/2} 0" size="0.014 0.014 0.008" material="sensor"/>
  <xacro:fixed_box_link name="front_lidar_link" xyz="0.073 0 0.002" size="0.018 0.030 0.014" material="sensor"/>

  <xacro:motor name="motor_1" x="${arm}" y="-${arm}"/>
  <xacro:motor name="motor_2" x="-${arm}" y="${arm}"/>
  <xacro:motor name="motor_3" x="${arm}" y="${arm}"/>
  <xacro:motor name="motor_4" x="-${arm}" y="-${arm}"/>
</robot>
