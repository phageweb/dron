Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Front Scan
      Topic:
        Value: /openipc_cinewhoop/scan/front
      Value: true
    - Class: rviz_default_plugins/Range
      Enabled: true
      Name: Down Range
      Color: 255; 170; 60
      Alpha: 0.5
      Topic:
        Value: /openipc_cinewhoop/range/down
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Trajectory
      Color: 60; 200; 255
      Line Width: 0.01
      Topic:
        Value: /openipc_cinewhoop/path
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Occupancy Map
      Topic:
        Durability Policy: Transient Local
        Value: /openipc_cinewhoop/map
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Front Camera
      Topic:
        Value: /openipc_cinewhoop/camera/image_raw
      Value: true
  Enabled: true
  Global Options:
    Fixed Frame: base_link
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
Window Geometry:
  Height: 900
  Width: 1400
