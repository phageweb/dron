# hw definition file for processing by chibios_hwdef.py
# bootloader for the Pavo20 AIO (dps/aio), derived from MicoAir743v2

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# private board ID, same as hwdef.dat
APJ_BOARD_ID 25026

# crystal frequency
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# bootloader starts at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
FLASH_BOOTLOADER_LOAD_KB 128

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART1

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA9  USART1_TX USART1
PA10 USART1_RX USART1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# chip selects held high so the SPI devices stay quiet
PD4  ICM42688_CS     CS
PA15 BMI270_CS       CS

PE2 LED_ACTIVITY   OUTPUT LOW # green
PE4 LED_BOOTLOADER OUTPUT LOW # blue
define HAL_LED_ON 0
