# hw definition file for processing by chibios_hwdef.py
# for the Pavo20 AIO (dps/aio): STM32H743VIH6 + 4x AM32 ESC, our own board.
#
# Derived from MicoAir743v2 (the target the MicoAir H743 V2 45A AIO runs,
# board ID 1179), so every pin below is the same as there unless a comment
# says otherwise. The schematic is dps/aio/mcu_h743.kicad_sch, the pin map
# with reasons dps/aio/NAVRH.md.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# Private board ID: not allocated by ArduPilot, outside every listed range.
# Ask for an official AP_HW_ name via a PR before the board is shared.
APJ_BOARD_ID 25026

# crystal frequency (HSE, PH0/PH1)
OSCILLATOR_HZ 8000000

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# flash size
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

# default to all pins low to avoid ESD issues
DEFAULTGPIO OUTPUT LOW PULLDOWN

# order of UARTs (and USB)
SERIAL_ORDER  OTG1 USART1 USART2 USART3 UART4 UART5 USART6 UART7 UART8

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# UARTs
PA9  USART1_TX USART1     # telemetry, J305 pin 3
PA10 USART1_RX USART1
PA2  USART2_TX USART2     # HD VTX, J201 pin 3
PA3  USART2_RX USART2     # HD VTX, J201 pin 4
PD8  USART3_TX USART3     # GPS WS-M181
PD9  USART3_RX USART3
PA0  UART4_TX  UART4      # MTF-02P, J304 pin 3
PA1  UART4_RX  UART4
PB6  UART5_TX  UART5
PB5  UART5_RX  UART5      # LD06 / D500 Tx, pad TP201
PC6  USART6_TX USART6     # receiver, J305 pin 5
PC7  USART6_RX USART6     # receiver TX, J305 pin 6; HD VTX J201 pin 6 (SBUS from DJI) only via JP202
PE8  UART7_TX  UART7
PE7  UART7_RX  UART7
PE1  UART8_TX  UART8
PE0  UART8_RX  UART8

# SWD (TP303, TP304)
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# order of I2C: I2C2 on the board is bus 0 (baro), I2C1 external is bus 1
I2C_ORDER I2C2 I2C1
PB8  I2C1_SCL I2C1
PB9  I2C1_SDA I2C1
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# PWM: 1-4 are the ESCs (MOTOR1-4), the rest go to pads
PE14 TIM1_CH4  TIM1  PWM(1)  GPIO(50) BIDIR
PE13 TIM1_CH3  TIM1  PWM(2)  GPIO(51)
PE11 TIM1_CH2  TIM1  PWM(3)  GPIO(52) BIDIR
PE9  TIM1_CH1  TIM1  PWM(4)  GPIO(53)
PB1  TIM3_CH4  TIM3  PWM(5)  GPIO(54) BIDIR
PB0  TIM3_CH3  TIM3  PWM(6)  GPIO(55)          # LIDAR_PWM, LD06 speed (R206 fitted = grounded)
PD12 TIM4_CH1  TIM4  PWM(7)  GPIO(56) BIDIR
PD13 TIM4_CH2  TIM4  PWM(8)  GPIO(57)          # VTX_EN, used as relay: RELAY1_PIN 57
PE5  TIM15_CH1 TIM15 PWM(9)  GPIO(58)
PE6  TIM15_CH2 TIM15 PWM(10) GPIO(59)
PD14 TIM4_CH3  TIM4  PWM(11) GPIO(60)

# BUZZER
PD15 BUZZER OUTPUT GPIO(61) LOW
define HAL_BUZZER_PIN 61

# LEDs
PE3 LED_RED   OUTPUT LOW GPIO(0)
PE2 LED_GREEN OUTPUT LOW GPIO(1)
PE4 LED_BLUE  OUTPUT LOW GPIO(2)
define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 0
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 1
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 2
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1

# ADC for power
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)

# battery: divider R303 100k / R304 10k, INA186A3 100 V/V on 0.2 mOhm = 20 mV/A
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 50.0

# compass: only external, in the WS-M181 GPS (the board has none)
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# barometer U302: SPL06-001 or DPS310, same footprint and pins, CSB and SDO
# high -> 0x77. Both report ID 0x10 in register 0x0D, so either driver would
# take either chip: list only the one that is fitted (SPL06, as on MicoAir).
# For a DPS310 replace the line with: BARO DPS310 I2C:0:0x77
BARO SPL06 I2C:0:0x77

# microSD J302 on SDMMC1
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
define FATFS_HAL_DEVICE SDCD1
define HAL_OS_FATFS_IO 1

# SPI2 - ICM-42688-P U303, second IMU (MicoAir has a BMI088 here, it did not fit the board)
PD3  SPI2_SCK        SPI2
PC2  SPI2_MISO       SPI2
PC3  SPI2_MOSI       SPI2
PD4  ICM42688_CS     CS
PC14 DRDY1_ICM42688  INPUT

# SPI3 - BMI270 (sheet IMU, U8)
PB3  SPI3_SCK      SPI3
PB4  SPI3_MISO     SPI3
PD6  SPI3_MOSI     SPI3
PA15 BMI270_CS     CS
PB7  DRDY3_BMI270  INPUT

# no SPI1 / AT7456E: the VTX is digital, OSD goes over MSP DisplayPort

# SPI devices
SPIDEV  icm42688  SPI2  DEVID1  ICM42688_CS  MODE3   2*MHZ 16*MHZ
SPIDEV  bmi270    SPI3  DEVID3  BMI270_CS    MODE3   1*MHZ 10*MHZ

# IMUs: the rotations depend on how the chips sit in the layout, set them then
IMU BMI270 SPI:bmi270 ROTATION_NONE
IMU Invensensev3 SPI:icm42688 ROTATION_NONE

# serial defaults that follow from the board's wiring
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_MSP_DisplayPort
define AP_MSP_VIDEOTX_ENABLED 1
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_RCIN

# OSD over MSP DisplayPort on the HD VTX
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 5
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

# setup for BF migration
define HAL_FRAME_TYPE 12
